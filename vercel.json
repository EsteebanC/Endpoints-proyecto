{
  "installCommand": "npm --prefix Frontend install --include=dev",
  "buildCommand": "npm --prefix Frontend run build",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://endpoints-proyecto.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
